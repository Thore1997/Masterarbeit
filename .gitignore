# ====================================
# Masterarbeit .gitignore (Latex and IDE)
# ====================================

# --- Documents & Output ---
*.pdf
out/
build/

# --- LaTeX Auxiliary and intermediate files ---
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.run.xml
*.nav
*.snm
*.vrb
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.xdy

# --- IDEs (JetBrains/PyCharm/VS Code) ---
.idea/
.vscode/
*.code-workspace
*.iml

# --- Python & Data Caches ---
__pycache__/
*.pyc
.ipynb_checkpoints/
*.pyo
*.pyd

# --- Virtual Environments  ---
venv/
venv-paper/
venv_paper/
env/
.env/

# --- Temporary / Backup files ---
*.bak
*.tmp
*.swp
*.sav
*.backup
*~
*.synctex(busy)
*.gz(busy)

# --- OS-specific ---
.DS_Store
Thumbs.db