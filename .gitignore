# ====================================
# Masterarbeit .gitignore (Latex and IDE)
# ====================================

# --- Documents & Output ---
# We exclude the PDF to keep the repo lean.
# Only the source code (.tex) should be versioned.
*.pdf
out/
build/

# --- LaTeX Auxiliary and intermediate files ---
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.run.xml
*.nav
*.snm
*.vrb
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.xdy

# --- IDEs (JetBrains/PyCharm/VS Code) ---
# This stops those ".idea/vcs.xml" files from cluttering your commits
.idea/
.vscode/
*.code-workspace
*.iml

# --- Python & Data Caches ---
# Since you have .py scripts in your subfolders
__pycache__/
*.pyc
.ipynb_checkpoints/
*.pyo
*.pyd

# --- Temporary / Backup files ---
*.bak
*.tmp
*.swp
*.sav
*.backup
*~
*.synctex(busy)
*.gz(busy)

# --- OS-specific ---
.DS_Store
Thumbs.db