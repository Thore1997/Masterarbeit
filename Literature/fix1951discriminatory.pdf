{"record":{"metadata":{"frontEndFullText":"https://apps.dtic.mil/sti/tr/pdf/ADA800391.pdf","unclassifiedTitle":"Discriminatory Analysis - Nonparametric Discrimination: Small Sample Performance","titleClassification":{"code":"U","description":"Unclassified"},"accessionNumber":"ADA800391","personalAuthors":[{"PersonalAuthors":{"num":"1","text":"Fix, Evelyn"}},{"PersonalAuthors":{"num":"2","text":"Hodges, Jr, J. L."}}],"personalAuthorsPdfMeta":["Fix, Evelyn","Hodges, Jr, J. L."],"replacedBy":null,"annotation":null,"mediaType":{"code":null},"exceptionPriceCode":null,"mediaDocumentNumber":null,"sbiHoldingSymbol":null,"tabIssueYear":null,"TaskNumber":{"taskNumber1":{"taskNumber1Pu":"4","taskNumber2Un":null},"taskNumber2":{"taskNumber2Pu":null,"taskNumber2Un":null}},"IACAccessionNumber":{},"iacDocumentType":{"code":null,"description":null},"iacSubjectTerms":[],"identifiers":{"identifier":[{"num":"1","text":"ATI COLLECTION"},{"num":"2","text":"ATI 159333"}]},"identifierClassification":{"code":"U","description":"Unclassified"},"classificationAuthority":null,"downgradingDate":null,"declassification":null,"regrade":{"code":null,"description":null},"changeAuthority":"AFSAM ltr, 12 May 1970","limitFlag":null,"specialIndicator":{"code":null,"description":null},"piis":{"type":null,"name":null,"id":null,"pii":{"id":null,"score":null,"top":null,"text":null}},"corporateAuthor":"CALIFORNIA UNIV BERKELEY","sourceCode":"071850","geopoliticalCode":"0608","organizationType":{"code":"0","description":"Public/State Academic"},"reportDate":"1952-08-01","abstractText":"A classification procedure is worked out for the following situations Two large samples, one from each of two populations, have been observed. An individual of unknown origin is to be classified as belonging to the first population if the majority of a specified odd number of individuals closet to the individual in question belong to the first population. This method has optimum properties when the number of closest individuals is permitted to be very large. For certain cases involving multivariate normal distributions with the same covariance matrix, the probabilities of possible misclassification have been computed and compared with those of the discriminant function method.","abstractClassification":{"code":"U","description":"Unclassified"},"descriptiveNote":"Air Technical Index","supplementaryNotes":null,"paginationOrMediaCount":"0048","paginationCode":null,"tabIssueNumber":null,"documentLocation":{"code":"1","description":"DTIC AND NTIS"},"reportNumbers":{"reportNumber1":{"unpunctuated":"UCB11","punctuated":"UCB-11"},"reportNumber2":{"unpunctuated":null,"punctuated":null}},"sourceSeries":null,"projectNumbers":{"projectNumber1":{"unpunctuated":"2149004","punctuated":"21-49-004"},"projectNumber2":{"unpunctuated":null,"punctuated":null}},"monitorSeries":{"monitorSeries1":{"unpunctuated":"SAM","punctuated":"SAM*"},"monitorSeries2":{"unpunctuated":null,"punctuated":null},"monitorSeries3":{"unpunctuated":null,"punctuated":null},"monitorSeries4":{"unpunctuated":null,"punctuated":null}},"contractNumber":{"contractNumber1":{"unpunctuated":"AF4112831","punctuated":"AF 41(128)-31"},"contractNumber2":{"unpunctuated":null,"punctuated":null}},"descriptors":[{"Descriptor":{"num":"1","text":"*NONPARAMETRIC STATISTICS"}},{"Descriptor":{"num":"2","text":"*DISCRIMINATE ANALYSIS"}},{"Descriptor":{"num":"3","text":"OPTIMIZATION"}},{"Descriptor":{"num":"4","text":"MULTIVARIATE ANALYSIS"}},{"Descriptor":{"num":"5","text":"PROBABILITY DISTRIBUTION FUNCTIONS"}},{"Descriptor":{"num":"6","text":"APPROXIMATION(MATHEMATICS)"}},{"Descriptor":{"num":"7","text":"NORMAL DISTRIBUTION"}},{"Descriptor":{"num":"8","text":"POPULATION(MATHEMATICS)"}},{"Descriptor":{"num":"9","text":"COVARIANCE"}},{"Descriptor":{"num":"10","text":"ERROR ANALYSIS"}},{"Descriptor":{"num":"11","text":"MATRICES(MATHEMATICS)"}},{"Descriptor":{"num":"12","text":"ANALYSIS OF VARIANCE"}},{"Descriptor":{"num":"13","text":"STATISTICAL SAMPLES"}}],"d